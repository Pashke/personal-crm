.env
.env.*
**/.env
**/.env.*

# Built and installed inside the image, local copies are not needed
node_modules
.next
tsconfig.tsbuildinfo
next-env.d.ts

# Not part of the app
.git
.github
.claude
deploy
specs
*.md
Dockerfile
.dockerignore
